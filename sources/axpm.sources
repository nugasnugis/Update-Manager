# /etc/apt/sources.list.d/axpm.sources
#
# axpm — Custom repository (DEB822 format)
# Place this file at:  /etc/apt/sources.list.d/axpm.sources
#
# CONFIGURATION REQUIRED — edit the three lines marked [CHANGE ME]:
#
#   1. URIs        — your axpm repo base URL
#   2. Suites      — your repo's distribution name / codename
#   3. Signed-By   — path to the GPG keyring for your repo (see install.sh)
#
# If your repo does not have source packages, remove the "deb-src" from Types.

Types: deb
# [CHANGE ME] Replace with your actual axpm repository URL:
URIs: https://repo.example.com/axpm
# [CHANGE ME] Replace with your repo's suite/codename (e.g. stable, testing, trixie):
Suites: stable
Components: main
# [CHANGE ME] Replace with the path where install.sh saved your repo's GPG key:
Signed-By: /usr/share/keyrings/axpm-archive-keyring.gpg
